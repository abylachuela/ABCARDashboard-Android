# Copia a .env (NO se versiona) y ajusta. Sin secretos reales en este archivo.
# Cualquier variable con valor sensible admite la variante NOMBRE_FILE=/ruta/al/archivo (Docker secrets).

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Rol de la aplicación (SIN ser propietario de las tablas). Ver db/roles.sql.
DATABASE_URL=postgres://educentro_app:CAMBIAME@127.0.0.1:5432/educentro
# Rol propietario: solo para migraciones y crear-admin si lo necesitas (por defecto se usa DATABASE_URL).
MIGRATION_DATABASE_URL=postgres://educentro_owner:CAMBIAME@127.0.0.1:5432/educentro

# >= 32 bytes aleatorios. Generar: openssl rand -base64 48   (OBLIGATORIO en producción)
SESSION_SECRET=
# URL pública (sin barra final): enlaces de recuperación y comprobación de Origin. Obligatoria en producción.
PUBLIC_URL=http://localhost:3000
# Orígenes extra permitidos para peticiones no seguras (separados por comas); p. ej. la app Capacitor: https://localhost
ALLOWED_ORIGINS=
# false | true | nº de saltos | lista de IP/CIDR. Detrás de nginx en la misma VM: 1 (o 127.0.0.1)
TRUST_PROXY=false

SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_HOURS=2
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=15
RESET_TOKEN_MIN=30
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_RECUPERAR_MAX=5
RATE_LIMIT_WINDOW_S=60

# Correo: consola (solo desarrollo; imprime el enlace) | smtp (obligatorio en producción)
MAIL_TRANSPORT=consola
MAIL_FROM=EduCentro <no-reply@ejemplo.invalid>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Solo para compose.yml (no las lee la API) ---
COMPOSE_PROJECT_NAME=educentro
API_BIND=127.0.0.1:3000
BACKUP_RETENTION_DAYS=30
