<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#0a0a1a</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">#00d4ff</item>
        <item name="android:windowBackground">#0a0a1a</item>
        <item name="android:statusBarColor">#0a0a1a</item>
        <item name="android:navigationBarColor">#0a0a1a</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0a0a1a</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
